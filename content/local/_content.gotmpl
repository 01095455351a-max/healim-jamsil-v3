{{/* 지역별 내원 안내 페이지를 data/local.yaml 에서 만든다.
     파일을 새로 만들지 않고 yaml 블록 하나로 한 쪽이 생긴다.
     화면은 layouts/local/single.html 이 그린다.

     description 은 params 가 아니라 dict 의 윗단에 둬야 .Description 으로
     읽힌다 — params 에만 두면 사이트 기본 설명이 나간다(실제로 그랬다). */}}
{{ range site.Data.local.areas }}
  {{ $.AddPage (dict
    "path"    .slug
    "kind"    "page"
    "title"   .title
    "date"    .date
    "description" .description
    "params"  (dict
      "title_seo"   .title_seo
      "description" .description
      "cta"         .cta
      "area"        .
    )
    "content" (dict "mediaType" "text/markdown" "value" "")
  ) }}
{{ end }}
